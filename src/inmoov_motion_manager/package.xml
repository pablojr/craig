<?xml version="1.0"?>
<package format="3">
  <name>inmoov_motion_manager</name>
  <version>0.1.0</version>
  <description>Configurable RViz joint-state gesture manager for InMoov.</description>
  <maintainer email="maintainer@example.com">InMoov Project</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>ament_pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
